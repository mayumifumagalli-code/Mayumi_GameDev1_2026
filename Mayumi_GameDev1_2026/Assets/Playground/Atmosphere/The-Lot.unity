  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Emission colours only its own surface. It lights nothing around it; bloom only makes its image glow.\n\n<b>Predict:</b> The neon sign is bright red. Does it light the cabinet, the pole or the ground below it?\n\n<b>Try:</b> Add a Point Light (GameObject \u203A Light \u203A Point Light) just under the front edge of the sign. Match its Color to the neon, then try Intensity about 5 and Range about 9. Compare the pole and the ground before and after.\n\n<size=85%><color=#A8A8A8>Reference: 29</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
