  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A light's colour can be set in Kelvin: Light \u203A Emission \u203A Light Appearance \u203A Filter and Temperature. Low values give orange light, high values blue-white. A sodium street lamp is about 1800 K; a fluorescent tube about 6500 K. All five lamps here have the same Intensity.\n\n<b>Predict:</b> Which of these lamps is closest to reference 25, and which to reference 26?\n\n<b>Try:</b> Set one lamp to match each reference with Temperature only. Then add a Filter colour on top.\n\n<size=85%><color=#A8A8A8>Reference: References 25, 26</color></size>"
  m_isRightToLeft: 0
