  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A wall stops light only by casting a shadow. A cookie is a texture on the light itself that masks part of its light (Light \u203A Emission \u203A Cookie).\n\n<b>Predict:</b> A: a Directional Light shines through a gap in a wall. B: a Spot Light with a slit cookie, and no wall. What differs between the two patches of light?\n\n<b>Try:</b> Set the Directional Light's Shadow Type to No Shadows. What happens to its slit?\n\n<size=85%><color=#A8A8A8>Reference: References 05-09</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
