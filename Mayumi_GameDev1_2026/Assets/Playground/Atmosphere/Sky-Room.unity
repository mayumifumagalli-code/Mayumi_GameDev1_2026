  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Skybox Material sets the sky. A <b>procedural</b> sky draws its sun where the <b>Sun Source</b> light points. An <b>HDRI</b> is one picture of a whole place: background, ambient light and reflections at once. A <b>solid colour</b> is an empty void.\n\n<b>Predict:</b> 1. Enable the second directional light, Moon. Which light does the sky's sun follow? 2. You rotate the HDRI sky (Rotation on its material). Do the shadows move?\n\n<b>Try:</b> Switch the Skybox Material between the three in Sky-Room/Materials: dusk, HDRI, solid colour. Press Generate Lighting after each. Then clear the Sun Source and make Moon brighter than Sun.\n\n<size=85%><color=#A8A8A8>Reference: Lighting window \u203A Environment: Skybox Material, Sun Source</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
