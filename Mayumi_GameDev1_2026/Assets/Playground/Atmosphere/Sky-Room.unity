  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Four settings look alike but do different jobs. <b>Background Type</b> (on the camera): what is drawn behind everything. <b>Skybox Material</b>: the sky itself. <b>Environment Lighting</b>: the light that comes from all around. <b>Environment Reflections</b>: what shiny surfaces show where no probe reaches.\n\n<b>Predict:</b> You set the camera's Background Type to Solid Color, black. The sky is gone from the picture. Is the plaza still lit by the sky?\n\n<b>Try:</b> Switch the four off one at a time and watch what changes: Background Type \xB7 Skybox Material (None) \xB7 Environment Lighting Intensity Multiplier (0) \xB7 Environment Reflections Intensity Multiplier (0). After every change to the sky, press Generate Lighting.\n\n<size=85%><color=#A8A8A8>Reference: Lighting window: Window \u203A Rendering \u203A Lighting, Environment tab</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
