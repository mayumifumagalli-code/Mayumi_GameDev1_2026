  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>What Lit can''t do:</b> change with the camera''s position. A Lit surface looks the same from near and far, and its edges are lit like the rest.


    <b>What this shader reads:</b> the view direction, to make the edges glow where the surface turns away from the camera (Fresnel); and the camera''s distance, to break the figure into dots closer than Fade Start and hide it closer than Gone At.


    Walk towards it in the Scene view: the Scene camera counts too.


    <size=85%><color=#A8A8A8>File: Assets/Library/Shaders/Liminal/Ghost.shader</color></size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
