--- !u!114 &4464708829220247066
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8901107589691942053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>What Lit can''t do:</b> show depth that is not there. On a flat window, Lit can only paint a picture of a room, and the picture does not change when you move.


    <b>What this shader reads:</b> the view direction. For each pixel it continues the line of sight into an imaginary box behind the glass, finds which wall, floor or ceiling the line hits, and colours the pixel with it. Each room''s lamp and back door are chosen by dice rolls. Every window here is a flat Quad.


    <size=85%><color=#A8A8A8>File: Assets/Library/Shaders/Liminal/Interior-Rooms.shader</color></size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
