--- !u!114 &4570472909772344956
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8727791163842559171}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>What Lit can''t do:</b> change by itself over time. A Lit material''s emission stays at the value you set.


    <b>What this shader reads:</b> time. Every fraction of a second it rolls dice made from the clock: whether the tube stutters, how bright each flash is, whether it dies for a moment. Broken sets how often. Its position is in the dice too, so two tubes never flicker together.


    The Spot Lights under the steady panels are separate lights. Panel 3 has none: emission colours only the panel itself.


    The flicker plays in Play mode, or in the Scene view with Always Refresh on.


    <size=85%><color=#A8A8A8>File: Assets/Library/Shaders/Liminal/Dying-Tube.shader</color></size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
