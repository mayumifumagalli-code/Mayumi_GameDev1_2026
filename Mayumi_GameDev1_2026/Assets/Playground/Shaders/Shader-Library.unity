  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>What Lit can''t do:</b> let light through a thin surface. Lit lights only the side that faces a light; the back of a curtain stays dark.


    <b>What this shader reads:</b> the lights on the far side of the cloth, which it adds as light coming through (the figure''s shadow comes through too); and time, in the vertex stage, which moves every vertex so the cloth waves. The curtain is a plane with 3,871 vertices: only vertices that exist can move.


    <size=85%><color=#A8A8A8>File: Assets/Library/Shaders/Liminal/Curtain.shader</color></size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
