      m_Calls: []
  m_text: "The Glass shader does not see the objects behind it. It reads the Opaque Texture: a copy of the frame that URP makes after drawing the opaque objects, before the transparent ones.\n\n<b>Predict:</b> You set this station's camera to make no Opaque Texture. What will the glass show through that camera?\n\n<b>Try:</b> Enable \"Camera - 5 \xB7 Glass needs the image behind it\" and look in the Game view. In its Inspector, under Rendering, set Opaque Texture to Off, then back to Use settings from Render Pipeline Asset.\n\n<size=85%><color=#A8A8A8>Reference: Shader library, 1 \xB7 Glass</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
