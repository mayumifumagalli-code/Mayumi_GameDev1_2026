      m_Calls: []
  m_text: "A material is a shader plus values for its properties. The shader decides which fields the material's Inspector shows.\n\n<b>Predict:</b> You switch this material's shader from Lit to Unlit, then to Liminal > Curtain, then back to Lit. Which fields stay? Does the orange colour survive? Do Smoothness and Metallic come back?\n\n<b>Try:</b> Select M_Train_Switch (Assets/Playground/Shaders/Training). In the Shader menu at the top of its Inspector choose Universal Render Pipeline > Unlit, then Liminal > Curtain, then Universal Render Pipeline > Lit. Watch the sphere and the fields.\n\n<size=85%><color=#A8A8A8>Reference: Lit shader, C \xB7 Lit, Simple Lit, Unlit</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
