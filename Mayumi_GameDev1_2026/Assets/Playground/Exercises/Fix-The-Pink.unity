  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This kiosk is an old download made for the Built-in render pipeline. Its materials use the Standard shader, which URP cannot run.\n\n<b>Predict:</b> What will the converter change in each material, and what will it keep?\n\n<b>Try:</b> 1. Convert: Window > Rendering > Render Pipeline Converter, tick Material Shader Converter, press Scan, then Convert Assets.\n2. Glass: make it see-through, with Surface Type Transparent or a new material made from Liminal > Glass.\n3. Grille: turn on Alpha Clipping.\n4. Sign: turn on Emission, with Kiosk-Sign as its Emission Map.\nSave the three fixed materials in your library.\n\n<size=85%><color=#A8A8A8>Reference: Shaders-Training, 4 \xB7 Magenta</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
