  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dirt, stains, wet patches, snow: a surface's wear and weather are layers on top of its material, placed by a mask. There are three ways to add them.\n\n<b>Row 1 \xB7 Inside the Lit shader:</b> the Detail Inputs and the Occlusion Map. No new shader.\n<b>Row 2 \xB7 Decals:</b> a Decal Projector draws a material onto every surface inside its box.\n<b>Row 3 \xB7 A shader that mixes by a mask:</b> two surfaces mixed in the shader's code, by a texture, the height or the direction a surface faces."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
