  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A mesh is made of vertices, edges and faces. ProBuilder lets you select each of them: Vertex, Edge and Face mode.\n\n<b>Predict:</b> You extrude the top face of this block once, upwards. How many faces will the block have afterwards?\n\n<b>Try:</b> In Face mode, select the top face and extrude it up 0.3 m. Move the new top face back to make a second step, then extrude again.\n\n<size=85%><color=#A8A8A8>Reference: Liminal kit, C \xB7 Stairs</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
