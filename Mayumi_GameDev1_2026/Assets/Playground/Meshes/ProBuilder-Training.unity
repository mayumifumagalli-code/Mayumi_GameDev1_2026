  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The graphics card draws only triangles. ProBuilder keeps four-sided and larger faces for editing and splits them into triangles for drawing. The number of triangles in a model is its polycount.\n\n<b>Predict:</b> How many triangles does each of the three shapes have? Put them in order, from fewest to most.\n\n<b>Try:</b> Set the Scene view's draw mode to Shaded Wireframe: the lines now show the triangles. Count the cube's. Then select the cube and use ProBuilder's Triangulate. Does the number of triangles change?\n\n<size=85%><color=#A8A8A8>Reference: Liminal kit, A \xB7 What a mesh is</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
