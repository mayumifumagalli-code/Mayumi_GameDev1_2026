--- !u!114 &5376758003620151082
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: '<b>The splashes.</b> A child Particle System <i>Splash</i>, used as a <b>Sub Emitter</b> of the rain on <i>Death</i>: 1 to 3 splashes per drop, lifetime 0.12 to 0.25 s, size 2 to 4 cm, <i>Shape: Hemisphere</i>, <i>Gravity Modifier</i> 1.5. Material <i>GS-Rain-Splash</i>.'
