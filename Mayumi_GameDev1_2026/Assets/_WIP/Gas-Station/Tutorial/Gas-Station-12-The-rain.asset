  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The rain is four <b>Particle Systems</b> (<i>GameObject \u203A Effects \u203A Particle System</i>) under an empty <i>Rain</i> at y = 12, turned \u221225\xB0 like the station. They are four boxes around the canopy, so no drop starts above it and the space under the canopy stays dry."
