  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: '<b>The URP Asset</b> (<i>Settings/PC_RPAsset</i>): <b>HDR</b> on (bright values above 1 are kept, so bloom can find them), <b>Depth Texture</b> and <b>Opaque Texture</b> on (the fog and the reflections read them), <b>Additional Lights: Per Pixel</b> with <b>Cast Shadows</b> on.'
