--- !u!114 &8465271810292333107
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "<b>The backdrop.</b> Wooden poles every 22 m along a line 26 m behind the station, 10 m tall, with three wires between them. The wires are <b>Line Renderers</b> (width 3.5 cm), each with a few points that sag in the middle. Two street lamps on 8 m posts stand at x = \u221230 and x = 24. In the fog, only their glow will be seen."
