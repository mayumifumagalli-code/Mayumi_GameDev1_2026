--- !u!114 &-8753271410613755153
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "<b>The kiosk</b> stands at (9.2, 0, 4.32), turned <b>65\xB0</b>, so its front faces the station. A box 6.4 \xD7 4.6 \xD7 3 m, a roof slab 7.0 \xD7 0.28 \xD7 5.6 m that overhangs the front, a front step 6.8 \xD7 0.14 \xD7 1.4 m."
