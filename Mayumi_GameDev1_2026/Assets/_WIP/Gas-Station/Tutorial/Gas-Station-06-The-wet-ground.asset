--- !u!114 &3079783435404939176
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: '<b>The ripples.</b> Rings on the water where drops land. The shader reads a normal map (<i>Ripple Normal</i>, tile 1.2 m, strength 0.35) only where the wet map is blue. An empty GameObject <i>Ripples</i> carries the <b>Ripple Flipbook</b> script: it steps the material''s <i>_RippleMap</i> through the 16 frames in <i>Textures/Ripples/</i> at 18 frames per second, so the rings appear and fade.'
