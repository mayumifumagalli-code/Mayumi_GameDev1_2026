  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: '<i>Fixture 1</i>, the one nearest the camera, flickers like a failing fluorescent tube. The <b>Tube Flicker</b> script on it drives the three lights of the fixture and its own tube material (<i>GS-Tube-Glass-Flicker</i>, a copy of <i>GS-Tube-Glass</i>) together: mostly on, with a burst of short drop-outs every few seconds. <i>Emission Property</i> is <i>_EmissionColor</i>. It runs in the Editor too, so the scene shows as changed while it is open.'
