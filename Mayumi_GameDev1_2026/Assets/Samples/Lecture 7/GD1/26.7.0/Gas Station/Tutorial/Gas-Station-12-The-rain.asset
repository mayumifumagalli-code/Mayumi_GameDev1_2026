  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: <b>Main module:</b> <i>Looping</i>, <i>Prewarm</i> and <i>Play On Awake</i> on, Start Lifetime 1.33 s, Start Speed 0, Start Size 0.02 (2 cm), <i>Max Particles</i> from the list (the default of 1000 would cut the rain). The drops fall from 12 m at 9 m/s, so they die exactly at the ground.
