--- !u!114 &-4027337383397599652
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "<b>The Player settings.</b> In <i>Edit \u203A Project Settings \u203A Player \u203A Other Settings</i>, add <i>URP_SCREEN_SPACE_REFLECTION</i> to <b>Scripting Define Symbols</b> and press <b>Apply</b>. Without this symbol the Screen Space Reflection feature does nothing."
