  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=75%>These shaders fake light and space that are not there: a failing tube, rooms behind a flat window, a figure that fades as you come near, a beam, a glow in the air, the light that water throws on a pool. Each reads something that Lit does not. None of them lights other objects.</size>\n\n<b>What each reads</b>\n<size=70%>1 Dying tube \xB7 time\n2 Interior rooms \xB7 the view direction\n3 Ghost \xB7 the view direction; the camera's distance\n4 Fake beam \xB7 a gradient; the view direction\n5 Glow volume \xB7 the camera's position; the depth behind it\n6 Caustics \xB7 time; the height in the world; the lights and their shadows</size>\n\n<size=65%><color=#B8B8B8>Files: Packages \u203A Toolbox \u203A Shaders \u203A Light-And-Space \xB7 Ready materials: Packages \u203A Toolbox \u203A Materials\nSurfaces: Shader-Library-Surfaces</color></size>"
  m_isRightToLeft: 0
