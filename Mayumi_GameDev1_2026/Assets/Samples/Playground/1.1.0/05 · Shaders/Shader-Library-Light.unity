  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "What this shader reads: time. Every fraction of a second it rolls dice made from the clock: whether the tube stutters, how bright each flash is, whether it dies for a moment. Broken sets how often. Its position is in the dice too, so two tubes never flicker together.\n\n<size=85%><color=#A8A8A8>File: Packages \u203A Toolbox \u203A Shaders \u203A Light-And-Space \u203A Dying-Tube.shader</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
