  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "What this shader reads: the view direction. For each pixel it continues the line of sight into an imaginary box behind the glass, finds which wall, floor or ceiling the line hits, and colours the pixel. Each room's lamp and back door are chosen by dice rolls. Every window is a flat Quad.\n\n<size=85%><color=#A8A8A8>File: Packages \u203A Toolbox \u203A Shaders \u203A Light-And-Space \u203A Interior-Rooms.shader</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
