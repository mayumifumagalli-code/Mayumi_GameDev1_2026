  m_text: "What this shader reads: the image behind the glass (the Opaque Texture), moved by the normal map and, for frosted glass, averaged over a small disc; and the depth behind it (the Depth Texture), so frost blurs far things more than near ones. The reflection on top comes from URP's lighting, as in Lit.\n\n<size=85%><color=#A8A8A8>File: Packages \u203A Toolbox \u203A Shaders \u203A Surfaces \u203A Glass.shader</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
