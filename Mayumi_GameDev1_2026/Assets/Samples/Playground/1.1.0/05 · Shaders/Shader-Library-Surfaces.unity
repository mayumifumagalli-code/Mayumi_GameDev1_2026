  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=75%>A shader is a program the graphics card runs for every vertex and every pixel of an object. In Unity it is a file. To use one, create a material and choose the shader in its Shader menu, under Mavrodiev > Surfaces. Each shader here reads something that the Lit shader does not.</size>\n\n<b>What each reads</b>\n<size=70%>1 Glass \xB7 the image and the depth behind it\n2 Water \xB7 time; the image and the depth behind it\n3 Curtain \xB7 the lights behind it; time, in the vertex stage\n4 Triplanar \xB7 the position in the world\n5 Toon and flat \xB7 the light's direction, in steps\n6 Screens and signs \xB7 time; a grid of its own</size>\n\n<size=65%><color=#B8B8B8>Files: Packages \u203A Toolbox \u203A Shaders \u203A Surfaces \xB7 Ready materials: Packages \u203A Toolbox \u203A Materials\nLight and space: Shader-Library-Light \xB7 Lit and its family: Lit-Shader</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
