  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A project can hold several URP Assets. Edit > Project Settings > Quality lists the quality levels; each level names its Render Pipeline Asset, and Unity draws with the one of the current level. Graphics > Default Render Pipeline is used only when a level names none.\n\n<b>Predict:</b> This project has two URP Assets, PC_RPAsset and Mobile_RPAsset, and the PC level is in use. You untick HDR on Mobile_RPAsset. Does the bloom around the neon frame change?\n\n<b>Try:</b>\n1. Open Edit > Project Settings > Quality and find the level in use and its Render Pipeline Asset.\n2. Untick Quality > HDR on Mobile_RPAsset and look at the neon frame. Tick it again.\n3. Untick Quality > HDR on PC_RPAsset and look. Tick it again.\n\n<size=85%><color=#A8A8A8>Reference: 9 \xB7 The course's global settings</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
