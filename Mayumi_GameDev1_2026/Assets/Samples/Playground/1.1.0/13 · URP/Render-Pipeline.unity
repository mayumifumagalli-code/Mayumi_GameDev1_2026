  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A frame is drawn in passes: separate steps for the shadow maps, the sky, the opaque objects, the transparent objects and post-processing. URP decides their order. The Frame Debugger (Window > Analysis) stops one frame and lists its passes and draws in the order they run.\n\n<b>Predict:</b> Is the sky drawn before or after the opaque objects?\n\n<b>Try:</b>\n1. Look through Camera - 6 in the Game view. Open Window > Analysis > Frame Debugger and press Enable.\n2. Drag the slider from the first draw to the last and watch the Game view.\n3. Find DrawOpaqueObjects and DrawSkybox in the list. Then press Disable.\n\n<size=85%><color=#A8A8A8>Reference: Shaders-Training, 5 \xB7 Glass needs the image behind it</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
