  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "An empty concrete space sounds big because sound reflects off its walls. An Audio Reverb Zone adds this echo to what the Audio Listener hears while it is inside the zone: fully inside Min Distance, less and less up to Max Distance. Its Reverb Preset sets the kind of space, such as Stone Corridor.\r\n\r\n<b>Predict:</b> If you disable the Audio Reverb Zone, how do the drips sound different?\r\n\r\n<b>Try:</b>\r\n1. Untick the Audio Reverb Zone on \"Reverb Zone \xB7 Underpass\", listen, then tick it again.\r\n2. Change Reverb Preset to Parking Lot, then to Cave.\r\n3. Move Camera - Listener outside the outer sphere of the zone's gizmo (beyond z 58) and listen.\r\n\r\n<size=85%><color=#A8A8A8>Reference: Unity Manual: Audio Reverb Zone</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
