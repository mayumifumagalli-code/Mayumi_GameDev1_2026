  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Light values</b>\n<size=60%>The light sources to look up. A visible light source has two parts: the fixture, an emissive surface that glows (above the Bloom Threshold, here 1, it blooms), and the light behind it, a Light component that lights the surfaces around it. A light whose fixture is in the picture is a practical light; a light with no fixture in the picture is a hidden light.\n\nThe values are this course's URP values, not physical units: start from them, then adjust by eye.\n\n<b>Row 1 \xB7 Outdoors</b> \u2014 1 Sodium street lamp \xB7 2 Neon \xB7 3 A lit window \xB7 4 Moonlight\n<b>Row 2 \xB7 Indoors</b> \u2014 5 Fluorescent tube \xB7 6 LED panel \xB7 7 A screen</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
