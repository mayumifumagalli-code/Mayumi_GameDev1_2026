  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A cookie is a texture on the light itself: it masks part of the light (Light \u203A Emission \u203A Cookie). Slit A is made by a wall: its shadow stops the rest of the light. Slit B is made by a cookie, with no wall, and it moves with the light.\n\n<b>Predict:</b> A: a Directional Light shines through a gap in a wall. B: a Spot Light with a slit cookie, and no wall. What differs between the two patches of light?\n\n<b>Try:</b>\n1. Set the Directional Light's Shadow Type to No Shadows and watch slit A.\n2. Rotate the Spot Light with the cookie and watch slit B.\n3. Set the Shadow Type back to Soft Shadows.\n\n<size=85%><color=#A8A8A8>Reference: References 05\u201309</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
