  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Emission colours only its own surface. It lights nothing around it; bloom only makes its image glow. A sign that should light the street needs a Light beside it, of the same colour.\n\n<b>Predict:</b> The neon sign is bright red. Does it light the cabinet, the pole or the ground below it?\n\n<b>Try:</b>\n1. Add a Point Light (GameObject \u203A Light \u203A Point Light) just under the front edge of the sign.\n2. Match its Color to the neon; try Intensity about 5 and Range about 9.\n3. Compare the pole and the ground before and after.\n\n<size=85%><color=#A8A8A8>Reference: Reference 29 \xB7 Light-Values 2 \xB7 Neon</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
