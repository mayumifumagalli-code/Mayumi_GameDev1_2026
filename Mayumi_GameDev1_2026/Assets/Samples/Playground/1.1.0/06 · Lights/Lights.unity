  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Lights</b>\n<size=70%>What a light does to a surface, and how it is shaped.</size>\n\n<size=60%><b>Row 1 \xB7 The light</b> \u2014 1 Three light types \xB7 2 The spot's cone and falloff \xB7 3 Colour temperature\n<b>Row 2 \xB7 Shadows</b> \u2014 4 The box with a hole \xB7 5 The slit, two ways \xB7 6 Shadow Distance\n<b>Row 3 \xB7 Lighting for the picture</b> \u2014 7 Three-point lighting \xB7 8 No bounce \xB7 9 Emission lights nothing \xB7 10 Count the lights\n\nEvery station has its own camera. The values of real light sources are in the Light-Values scene.</size>"
