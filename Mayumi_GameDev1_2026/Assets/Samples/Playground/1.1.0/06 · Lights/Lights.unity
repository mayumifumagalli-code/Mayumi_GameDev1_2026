  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Three lights on one object. The Key Light is the strongest and shapes the object. The Fill Light is weaker and softens the key''s shadows. The Rim Light comes from behind and outlines the edges.


    <b>Predict:</b> Switch off one light at a time. Which one, when it is off, lets the figure merge with the dark behind it?


    <b>Try:</b>

    1. Switch the Key, Fill and Rim Lights off in turn.

    2. Change their Intensity until the figure reads well.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
