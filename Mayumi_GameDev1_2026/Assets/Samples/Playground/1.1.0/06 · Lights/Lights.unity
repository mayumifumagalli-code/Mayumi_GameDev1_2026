  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Spot Light lights a cone. At the outer angle (Shape \u203A Inner / Outer Spot Angle) its light ends. Between the inner and the outer angle it fades out, so the edge of its pool can be soft or hard. Its light also weakens with distance, and reaches zero at the Range.\n\n<b>Predict:</b> Spots A and B have the same outer angle, 70\xB0. A has an inner angle of 68\xB0, B of 10\xB0. How do the edges of their two pools differ?\n\n<b>Try:</b>\n1. On Lamp B's Spot Light, set the inner angle to 68, then back to 10.\n2. Lower Lamp A's Range step by step from 7 to 2, watching its pool.\n3. Set the Range back to 7.\n\n<size=85%><color=#A8A8A8>Reference: Light-Values 1 \xB7 Sodium street lamp</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
