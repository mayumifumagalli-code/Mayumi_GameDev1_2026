  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Real-time light does not bounce. A surface is lit only where a light reaches it directly; elsewhere only the ambient light reaches it. A weak light placed where the bounce would come from fakes it: a fill light.\n\n<b>Predict:</b> Kiosk Light points down at the counter and the window. In a real room the back wall and the ceiling would get some light back. What do they get here?\n\n<b>Try:</b>\n1. Add a Spot Light (GameObject \u203A Light \u203A Spot Light) by the counter.\n2. Aim it up and back; set Intensity about 1 and Shadow Type No Shadows.\n3. Check that it lights nothing outside the kiosk.\n\n<size=85%><color=#A8A8A8>Reference: Reference 26</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
