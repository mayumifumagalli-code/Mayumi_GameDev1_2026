  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Start Size and Start Color are set once, when a particle is born. The Size over Lifetime and Color over Lifetime modules change them during its life: a curve for the size, a gradient for the colour and the transparency. The left end of each is the particle's birth; the right end is its death.\n\n<b>Predict:</b> These puffs appear at full size and vanish at once. What will you see if Color over Lifetime fades the alpha from 0 at birth up to 1, and back to 0 at the end?\n\n<b>Try:</b>\n1. Tick Color over Lifetime. In its gradient, set the alpha keys to 0, 1, 0.\n2. Tick Size over Lifetime and draw a curve that rises from 0.3 to 1.\n3. Change Start Color to orange and compare.\n\n<size=85%><color=#A8A8A8>Reference: Particle-Effects, 3 \xB7 Steam</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
