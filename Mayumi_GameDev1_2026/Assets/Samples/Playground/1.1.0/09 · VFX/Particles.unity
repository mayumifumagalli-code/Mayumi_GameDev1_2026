  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Each particle lives for its Start Lifetime, in seconds, then disappears. Start Speed pushes it away from the shape when it is born. Gravity Modifier pulls it down: 1 is the project's gravity, 0 is none. Together, these settings decide how far a particle travels and the path it follows.\n\n<b>Predict:</b> These particles leave the emitter straight up at Start Speed 5, live for 1 second and have Gravity Modifier 0, so they reach the 5 m mark. If you set Gravity Modifier to 1, about how high do they go?\n\n<b>Try:</b>\n1. Set Gravity Modifier to 1 and read the height on the pole.\n2. Set Start Lifetime to 3 and watch where the particles die.\n3. Raise Start Speed until they reach the 5 m mark again.\n\n<size=85%><color=#A8A8A8>Reference: Particle-Effects, 1 \xB7 Rain and 7 \xB7 Sparks</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
