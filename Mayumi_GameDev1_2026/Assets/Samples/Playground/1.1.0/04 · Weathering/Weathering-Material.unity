  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Lit shader's Detail Inputs lay a second texture over the surface: here, grime with its own normal map. The Detail Inputs' Mask decides where it shows (the mask's alpha channel: white = detail, black = none). This mask keeps the grime near the ground.\n\n<b>Predict:</b> The wall's Base Map has Tiling 0.5. You change it to 1. What happens to the concrete boards, and to the band of grime at the bottom?\n\n<b>Try:</b>\n1. Select the wall's material, M_Surf_Grime-Bottom, in this scene's Materials folder.\n2. Change the Base Map's Tiling from 0.5 to 1.\n3. Set the Detail Inputs' Mask to None.\n\n<size=85%><color=#A8A8A8>Reference: Texture-Placement, 4 \xB7 Repetition at scale</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
