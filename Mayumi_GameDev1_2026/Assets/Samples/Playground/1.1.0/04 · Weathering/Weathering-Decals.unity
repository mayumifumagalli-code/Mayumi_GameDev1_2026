  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Paint wears off first on edges, where feet, carts and hands hit them. This decal sits across the edge of a painted step, its box turned 45 degrees, so it projects onto the top and the front at once. Its texture is a strip: chips along the middle, none at the sides.\n\n<b>Predict:</b> You move the step 1 m to the side. Does the worn edge move with it?\n\n<b>Try:</b>\n1. Move the step to the side, then back.\n2. In the Hierarchy, drag Decal - Edge wear onto the step, so it becomes the step's child; move the step again.\n3. Change the decal's Width until it covers the whole edge.\n\n<size=85%><color=#A8A8A8>Reference: Unity basics: GameObjects-And-Components, 5 \xB7 Parent and child</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
