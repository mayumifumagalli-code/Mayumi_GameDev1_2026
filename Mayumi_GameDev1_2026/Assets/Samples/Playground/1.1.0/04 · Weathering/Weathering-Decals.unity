  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Decals add wear where it happens: a leak below a window sill, dirt at the base of a wall. Each is a Decal Projector pointing into the wall, with a material made from URP's own decal shader (Shader Graphs/Decal).\n\n<b>Predict:</b> The box of the dirt decal also reaches into the floor in front of the wall. What will the floor inside the box look like?\n\n<b>Try:</b>\n1. Select Decal - Dirt at the base and look at its box.\n2. Change its Pivot and Height until the box stops at the floor.\n3. Make a decal of your own: GameObject \u203A Rendering \u203A URP Decal Projector, then the New button next to its Material \u203A URP Decal.\n\n<size=85%><color=#A8A8A8>Reference: Weathering-Shaders, 4 \xB7 Damp from the ground</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
