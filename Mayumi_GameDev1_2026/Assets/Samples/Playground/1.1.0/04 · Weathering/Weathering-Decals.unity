  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A poster or a sign can be a decal: no new mesh, it follows the wall. This one (URP's decal shader) changes only the Base Color; its Normal Blend is 0. A spot light grazes the wall from the side.\n\n<b>Predict:</b> Will the board marks of the concrete show through the poster?\n\n<b>Try:</b>\n1. Select the poster's material, M_Decal_Poster, and raise Normal Blend from 0 to 1.\n2. Move the side light.\n3. Put the leak or the rust stain material on this projector.\n\n<size=85%><color=#A8A8A8>Reference: Texture-Maps, 2 \xB7 A normal map fakes detail</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
