  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A wet surface is darker (water fills the pores) and smoother (a film of water). The shader Mavrodiev > Weathering > Wet-Puddles has a slider for each: Wet Darkening and Wet Smoothness. A is dry, B only darker, C only smoother, D both. The light box behind gives them something to reflect.\n\n<b>Predict:</b> Which of B, C and D looks wet?\n\n<b>Try:</b>\n1. Select C's material, M_Surf_Wet-C-Smoother, and raise Wet Darkening.\n2. On B's material, M_Surf_Wet-B-Darker, raise Wet Smoothness.\n3. Orbit low over the slabs.\n\n<size=85%><color=#A8A8A8>Reference: Material-Chart, 1 \xB7 Reference values (wet asphalt)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
