  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Snow settles on what faces up. The shader Mavrodiev > Weathering > Snow-Top measures, for every pixel, how much the surface faces up in the world, and mixes in the snow (colour, smoothness, a flatter normal) above a threshold set by Snow Amount.\n\n<b>Predict:</b> You turn the block on the left 90 degrees around Z, onto its side. Where is the snow afterwards?\n\n<b>Try:</b>\n1. Rotate the blocks and the bench in the Scene view.\n2. Change Snow Amount on M_Surf_Snow-Concrete.\n3. Set Snow Color to a light brown-grey: the same layer becomes dust.\n\n<size=85%><color=#A8A8A8>Reference: Shaders-Training, 6 \xB7 The texture belongs to the world</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
