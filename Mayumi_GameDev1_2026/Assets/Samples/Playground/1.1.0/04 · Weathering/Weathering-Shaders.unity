  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Rising damp: the bottom of the wall is darker and a little smoother, up to a ragged line with a pale edge of salt. The shader Mavrodiev > Weathering > Damp-Base measures the height of each pixel in the world, from Ground Height.\n\n<b>Predict:</b> You move the wall 1 m up (Position Y = 1). Does the damp move up with the wall?\n\n<b>Try:</b>\n1. Move the wall up and down.\n2. Change Damp Height and Edge Raggedness on M_Surf_Damp-Plaster.\n3. Compare with Weathering-Material, 1, where the grime is placed by the UVs.\n\n<size=85%><color=#A8A8A8>Reference: Weathering-Material, 1 \xB7 The Detail Mask</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
