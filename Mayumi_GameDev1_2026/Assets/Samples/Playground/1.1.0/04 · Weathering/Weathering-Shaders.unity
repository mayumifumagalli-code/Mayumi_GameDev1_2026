  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The puddles are placed by a grey mask used as a height map: dark is low. Water fills every part of the mask below the Water Level. There the surface is darker, almost perfectly smooth and flat, with rain ripples computed in the shader. Shader: Mavrodiev > Weathering > Wet-Puddles.\n\n<b>Predict:</b> You raise the Water Level a little. Where does new water appear first?\n\n<b>Try:</b>\n1. On M_Surf_Puddles, move Water Level.\n2. Move Rain Ripples.\n3. In Environment \u203A Volume - Neutral + SSR, turn the Screen Space Reflection override off, then on again.\n\n<size=85%><color=#A8A8A8>Reference: Weathering-Decals, 5 \xB7 Rain ripples</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
