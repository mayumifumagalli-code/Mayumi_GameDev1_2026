  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%>Dirt, stains, wet patches and snow are layers on top of a surface's material, placed by a mask. There are three ways to add them, one scene each: inside the Lit shader (Weathering-Material), with decals (Weathering-Decals), and with a shader that mixes two surfaces by a mask (Weathering-Shaders).</size>\n\n<b>Weathering-Material \xB7 Inside the Lit shader</b>\n<size=70%><color=#B8B8B8>1 The Detail Mask \xB7 2 Darker or lighter \xB7 3 Occlusion and the light \xB7 4 Weathering states</color></size>\n\n<b>Weathering-Decals \xB7 Decals</b>\n<size=70%><color=#B8B8B8>1 A decal is a box \xB7 2 Decals on a wall \xB7 3 A poster on rough concrete \xB7 4 A puddle of smoothness \xB7 5 Rain ripples \xB7 6 Edge wear \xB7 7 Exercise: Weather a kit piece</color></size>\n\n<b>Weathering-Shaders \xB7 Shaders that mix by a mask</b>   <color=#F2C14E>\xB7 You are here</color>\n<size=70%>1 Wet: darker and smoother \xB7 2 Puddles: a mask and a level \xB7 3 Snow on what faces up \xB7 4 Damp from the ground</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
