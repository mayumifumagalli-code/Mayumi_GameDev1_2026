  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bloom appears only when every switch on its path is on:\n1  Camera \u203A Rendering \u203A Post Processing\n2  URP Asset \u203A Quality \u203A HDR\n3  Renderer \u203A Post-processing \u203A Enabled\n4  a Volume with a Profile\n5  the override and each of its properties ticked\n6  an emission brighter than the Threshold\n\n<b>Predict:</b> This frame has no glow at all. Which of the six are off?\n\n<b>Try:</b>\n<b>Find:</b> look through Camera - The Monument in the Game view and check the six switches in order. Note which are off.\n<b>Fix:</b> switch on what this scene lacks. The URP Asset and the Renderer (Assets/Settings/PC_RPAsset, PC_Renderer) are shared by the whole project: check them, don't change them.\n<b>Check:</b> the ring glows in the Game view, from every camera that shows it.\n\n<size=85%><color=#A8A8A8>Reference: References 01\u201304</color></size>"
  m_isRightToLeft: 0
