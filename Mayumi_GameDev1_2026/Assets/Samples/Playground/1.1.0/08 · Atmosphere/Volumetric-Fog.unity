  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The fog's density can change with height. Below Base Height the fog has its full Density; above it, the fog thins out to nothing at Maximum Height. A low Maximum Height keeps a mist lying over water and floors. The fog cannot be kept inside a box: the camera sees it over its whole picture.\n\n<b>Predict:</b> In Volume - Fog (global), you set Maximum Height to 1.5. Where will the fog be?\n\n<b>Try:</b>\n1. Select Volume - Fog (global) and set Volumetric Fog \u203A Maximum Height to 1.5.\n2. Raise Density until the mist reads over the water.\n3. Set Maximum Height back to 12 and Density back to 0.35: every station uses this Volume.\n\n<size=85%><color=#A8A8A8>Reference: none yet</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
