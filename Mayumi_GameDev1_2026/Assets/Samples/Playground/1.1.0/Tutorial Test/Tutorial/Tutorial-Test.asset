  m_Script: {fileID: 11500000, guid: a8abd1cbb83a66041a53effcda8e4c96, type: 3}
  m_Name: TryParagraph
  m_EditorClassIdentifier: Mavrodiev.Tutorials.Editor::Mavrodiev.Tutorials.Editor.TryParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title: Bring every sphere inside the range
  Text: '1. Select a sphere and look at its material in the <b>Inspector</b>.

    2. Click the <b>Base Map</b> colour. In the colour picker, read the RGB values (0 to 255).

    3. Change each sphere that is outside the range so that all three values are between 32 and 243.'
  Check: {fileID: 2057483793008809703}
  Blocking: 0
  Page: {fileID: -651317260642683561}
