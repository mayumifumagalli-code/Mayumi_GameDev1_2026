      m_Calls: []
  m_text: "<b>Reflections</b>\n<size=70%>What a smooth surface shows. The sky here is black: where no Reflection Probe reaches, a smooth surface reflects black.</size>\n\n<size=60%><b>Row 1 \xB7 Reflection probes</b> \u2014 1 No probe, or a probe \xB7 2 Box Projection\n<b>Row 2 \xB7 Sharper reflections</b> \u2014 3 Screen Space Reflections \xB7 4 Planar reflection\n<b>Row 3 \xB7 The wet floor</b> \u2014 5 One wet floor, three ways \xB7 6 Wet needs something to reflect\n\nStations 3 and 5 change the scene's Volume: set Screen Space Reflection back to Disabled after them.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
