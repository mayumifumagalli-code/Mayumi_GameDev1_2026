  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A smooth surface shows a picture of its surroundings taken from somewhere else: the sky, or the nearest Reflection Probe. A probe is a cubemap captured from one point and used by the objects inside its box. This probe is baked: it changes only when it is baked again.\n\n<b>Predict:</b> Two identical arcades stand on a wet floor. A has no probe; B has a Reflection Probe. What does each floor reflect?\n\n<b>Try:</b>\n1. Switch B's Reflection Probe off and on.\n2. Move B's warm glow 1 m to the side.\n3. Select the Reflection Probe and press Bake; compare.\n\n<size=85%><color=#A8A8A8>Reference: Materials-Training 6 \xB7 Reflections</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
