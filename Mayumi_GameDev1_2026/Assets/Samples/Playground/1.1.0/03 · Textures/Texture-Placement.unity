  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The UVs place the texture on the surface, and Tiling repeats it. A tileable texture continues seamlessly across its edges, so its copies join without a seam. A unique picture does not: its copies show where they meet.\n\n<b>Predict:</b> Set Tiling to 2 on A and on B. Which still looks like one continuous surface?\n\n<b>Try:</b>\n1. Select panel A's material and set Tiling X and Y to 2.\n2. Do the same on panel B.\n3. Look at the lines where the copies meet.\n\n<size=85%><color=#A8A8A8>Reference: Textured materials, 2 \xB7 Walls (Concrete panels)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
