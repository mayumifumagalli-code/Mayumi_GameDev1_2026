  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Texel density is how many texture pixels cover one metre of surface. When it is the same everywhere, a brick is the same size on every wall. The same texture on a larger surface, at the same Tiling, spreads its pixels further apart. Tiling corrects it.\n\n<b>Predict:</b> C and D use the same brick texture at Tiling 1. Which Tiling X on D makes its bricks match C?\n\n<b>Try:</b>\n1. Turn on Tools \u203A Mavrodiev \u203A Texel Density View: compare the checks on C and D.\n2. Change Tiling X on D's material until both show the same checks.\n3. Turn the view off.\n\n<size=85%><color=#A8A8A8>Reference: Textured materials, 2 \xB7 Walls (Brick)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
