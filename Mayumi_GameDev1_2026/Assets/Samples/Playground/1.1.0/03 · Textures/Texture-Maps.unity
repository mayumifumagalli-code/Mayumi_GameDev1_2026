  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Lit shader takes a texture for each of its main inputs: Base Map, Normal Map, Metallic Map (with smoothness in its alpha) and Occlusion Map. Each step here adds one map to the one before.\n\n<b>Predict:</b> Which step makes the grout lines look recessed?\n\n<b>Try:</b>\n1. Open material 4.\n2. Remove its maps one at a time.\n3. Watch what changes on the sphere and on the slab.\n\n<size=85%><color=#A8A8A8>Reference: Textured materials, 1 \xB7 Floors (Pool tiles)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
