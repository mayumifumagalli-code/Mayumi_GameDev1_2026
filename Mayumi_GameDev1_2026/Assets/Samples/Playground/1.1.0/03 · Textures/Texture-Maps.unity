  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A height map stores how high each pixel is: white is high, black is low. Lit's Height Map shifts the texture with the viewing angle (parallax), so the grout seems to sink between the tiles. The mesh stays flat: its edge and its shadows do not change.\n\n<b>Predict:</b> Look at the right floor from a low angle. Does its edge show the depth of the grout?\n\n<b>Try:</b>\n1. Compare the two floors from the station camera, then from a low angle in the Scene view.\n2. On the right material, set the Height Map's scale from 0.005 to 0.08.\n3. Look at the tiles near the edge.\n\n<size=85%><color=#A8A8A8>Reference: Textured materials, 1 \xB7 Floors (Pool tiles)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
