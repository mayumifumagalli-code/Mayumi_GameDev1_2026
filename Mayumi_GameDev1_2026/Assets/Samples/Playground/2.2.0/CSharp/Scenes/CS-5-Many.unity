  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Physics.OverlapSphere returns an array of every collider inside a sphere. The foreach loop takes each one. A collider with no Rigidbody on its object is in the array too: the if skips it. Every Rigidbody found gets AddExplosionForce, a push away from the centre.\n\n<b>Predict:</b> How many times does the body of the loop run?\n\n<b>Try:</b>\n1. Press Play, select Bomb 4, open Code Watch.\n2. Click 4 \xB7 Explode. Read the number beside the body.\n3. Click 4 \xB7 Put back, set Force to 30, explode again."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
