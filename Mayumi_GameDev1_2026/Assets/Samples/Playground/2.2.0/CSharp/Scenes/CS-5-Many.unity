  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "An if inside a loop decides for each value on its own. ExplodeTagged loops over the colliders in the sphere, like Explode, but pushes a Rigidbody only when it has the Required Tag, Player. CompareTag checks the Tag set at the top of the Inspector. The blue crates are tagged Player, the brown ones Untagged.\n\n<b>Predict:</b> You click 5 \xB7 Explode tagged. Which crates move?\n\n<b>Try:</b>\n1. Press Play and click 5 \xB7 Explode tagged.\n2. Click 5 \xB7 Put back. Select a brown crate, set its Tag to Player.\n3. Click 5 \xB7 Explode tagged again."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
