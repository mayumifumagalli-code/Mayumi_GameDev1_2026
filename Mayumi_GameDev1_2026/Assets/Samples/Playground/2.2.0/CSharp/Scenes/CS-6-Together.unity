  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "GameManager holds an AlarmMeter in its Alarm Meter slot. The alarm is private: only AlarmMeter can change it, and GetAlarm(), a public method, returns its value. Every frame, Update calls alarmMeter.GetAlarm() and compares the answer with loseAt. When it reaches loseAt, GameManager fires On Lose once, and Lamp 2 turns red.\n\n<b>Predict:</b> Lose At is 75, and each click of 2 \xB7 Raise alarm adds 25. After which click does Lamp 2 turn red?\n\n<b>Try:</b>\n1. Press Play, select Game Manager 2 and open Code Watch.\n2. Click 2 \xB7 Raise alarm, and watch the two lines inside the if.\n3. Stop, set Lose At to 100, and try again."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
