  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Meter keeps a level between 0 and 1. Fill adds to it, and Update takes a little away every frame. When the level rises to the threshold, On Full fires and Lamp 7 turns on. When it falls below, On Low fires and the lamp turns off. isFull remembers which happened last.\n\n<b>Predict:</b> Lamp 7 is on, and you stop clicking. Does it turn off by itself?\n\n<b>Try:</b>\n1. Press Play and select Meter 7.\n2. Click 7 \xB7 Fill four times, and watch the bar and Level.\n3. Stop clicking, and wait."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
