  m_GameObject: {fileID: 629442907}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A controller is a script that holds values and writes them into the engine every frame. The fog is not a component: it is a Lighting setting of the scene. FogController holds one number, density, and Update writes it into RenderSettings.fogDensity.


    <b>Predict:</b> While the game runs, you drag Density up. Does the fog change at once, or the next time you press Play?


    <b>Try:</b>

    1. Press Play and select Fog 5.

    2. Drag Density towards 0.1 and watch the dark posts far away.

    3. In Code Watch, watch the line in Update run every frame.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
