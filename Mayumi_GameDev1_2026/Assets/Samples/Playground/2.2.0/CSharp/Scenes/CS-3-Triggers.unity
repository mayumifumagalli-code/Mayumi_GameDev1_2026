      m_Calls: []
  m_text: "LifecycleTrigger turns Unity's own methods into events. Unity calls Awake and Start once for the object, OnEnable each time it is switched on, OnDisable each time it is switched off, and Update every frame while it is on. On Enable switches Lamp 6 on; On Disable switches it off.\n\n<b>Predict:</b> You switch Block 6 off, then on again. Which of Awake, OnEnable and Start run again?\n\n<b>Try:</b>\n1. Press Play, select Block 6 and open Code Watch.\n2. Click 6 \xB7 Switch off, then 6 \xB7 Switch on.\n3. Watch Lamp 6, and the methods that light up."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
